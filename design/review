<!-- Client-side Audio Playback Simulation -->
<script>
  (function() {
    const voiceBtn = document.getElementById('voice-summary-btn');
    const speakerIcon = document.getElementById('speaker-icon');
    const speakerText = document.getElementById('speaker-text');
    let isPlaying = false;

    if (voiceBtn) {
      voiceBtn.addEventListener('click', function() {
        isPlaying = !isPlaying;
        if (isPlaying) {
          speakerIcon.textContent = 'pause_circle';
          speakerText.textContent = 'रोकें (Pause)';
          voiceBtn.classList.add('bg-primary', 'text-on-primary');
          voiceBtn.classList.remove('bg-secondary-fixed', 'text-primary');
        } else {
          speakerIcon.textContent = 'volume_up';
          speakerText.textContent = 'स्पीकर से सुनें';
          voiceBtn.classList.remove('bg-primary', 'text-on-primary');
          voiceBtn.classList.add('bg-secondary-fixed', 'text-primary');
        }
      });
    }
  })();
</script></main>

</body></html>